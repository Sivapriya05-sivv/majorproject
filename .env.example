# ADHD LEARNING WORLD - ENVIRONMENT VARIABLES
# Connect to your Supabase project (from Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: NEVER put service_role secret key here or anywhere in frontend!
